{
    "name": "@frontier-fi/sdk",
    "description": "SDK for interacting with the Frontier protocol",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/frontier-fi/sdk.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "version": "0.1.0",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "files": [
        "dist/"
    ],
    "scripts": {
        "codegen": "graphql-codegen-esm --config codegen.yml",
        "prebuild": "pnpm run codegen",
        "build": "tsup",
        "prepare": "pnpm exec tsup",
        "format": "biome format --write .",
        "lint": "dpdm -T ./src && biome check .",
        "check-types": "tsc --noEmit --skipLibCheck",
        "check-types:release": "tsc -p tsconfig.build.json --noEmit --skipLibCheck",
        "test": "vitest dev",
        "test:all": "vitest run",
        "test:no-integration": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"**/*.contract.test.ts\"",
        "test:release": "vitest run --config vitest.release.config.mts",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "prepublishOnly": "pnpm check-types:release && pnpm test:release && pnpm exec tsup",
        "example": "npx tsx ./examples/lib/executeExample.ts",
        "update:deployments": "npx tsx ./scripts/updateDeployments.ts && pnpm format"
    },
    "dependencies": {
        "@frontier-fi/maths": "0.1.1",
        "viem": "2.57.11"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@changesets/cli": "3.0.3",
        "@graphql-codegen/cli": "^7.0.0",
        "@graphql-codegen/typescript": "^6.0.1",
        "@graphql-codegen/typescript-operations": "^6.0.3",
        "@types/async-retry": "1.4.9",
        "@types/node": "22.14.1",
        "@viem/anvil": "0.0.10",
        "dotenv": "17.4.2",
        "dpdm": "4.2.0",
        "graphql": "^16.11.0",
        "graphql-tag": "^2.12.6",
        "pino-pretty": "13.1.3",
        "ts-node": "10.9.2",
        "tsup": "8.5.1",
        "tsx": "^4.8.1",
        "typescript": "5.9.3",
        "vite": "8.0.16",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.8"
    },
    "packageManager": "pnpm@10.8.1",
    "engines": {
        "node": ">=20.x"
    }
}
